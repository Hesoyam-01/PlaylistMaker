<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    android:orientation="vertical"
    tools:context=".ui.library.MakePlaylistFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/new_playlist_toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:contentInsetStartWithNavigation="64dp"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/new_playlist"
        app:titleTextAppearance="@style/ToolbarStyle" />

    <ImageView
        android:id="@+id/set_playlist_cover"
        android:layout_width="312dp"
        android:layout_height="312dp"
        android:layout_gravity="center"
        android:layout_marginTop="26dp"
        android:background="@drawable/add_photo_background"
        android:scaleType="center"
        android:src="@drawable/ic_add_photo_100" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/default_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="33dp"
            android:backgroundTint="@android:color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOnPrimaryFixedVariant"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/song_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="@font/ys_display_regular"
                android:hint="@string/title"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/default_padding"
                android:singleLine="true"
                android:textColor="@color/dark_gray"
                android:textColorHighlight="@color/blue"
                android:textColorHint="?attr/colorOnPrimary"
                android:textFontWeight="400"
                android:textSize="@dimen/small_textSize" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_padding"
            android:background="?attr/colorPrimary"
            android:fontFamily="@font/ys_display_regular"
            android:paddingHorizontal="3dp"
            android:text="@string/title"
            android:textColor="?attr/colorOnPrimaryFixedVariant"
            android:textFontWeight="400"
            android:textSize="12sp"
            android:translationY="26dp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="105dp"
            android:backgroundTint="@android:color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOnPrimaryFixedVariant"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/song_description"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="@font/ys_display_regular"
                android:hint="@string/description"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/default_padding"
                android:singleLine="true"
                android:textColor="@color/dark_gray"
                android:textColorHighlight="@color/blue"
                android:textColorHint="?attr/colorOnPrimary"
                android:textFontWeight="400"
                android:textSize="@dimen/small_textSize" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_padding"
            android:background="?attr/colorPrimary"
            android:fontFamily="@font/ys_display_regular"
            android:paddingHorizontal="3dp"
            android:text="@string/description"
            android:textColor="?attr/colorOnPrimaryFixedVariant"
            android:textFontWeight="400"
            android:textSize="12sp"
            android:translationY="98dp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="35dp"
            android:paddingHorizontal="17dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">


            <Button
                android:id="@+id/make_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/make_button_colors"
                android:elevation="0dp"
                android:enabled="false"
                android:fontFamily="@font/ys_display_medium"
                android:insetTop="0dp"
                android:insetBottom="dp"
                android:letterSpacing="0"
                android:text="@string/make"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textFontWeight="500"
                android:textSize="@dimen/small_textSize" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>