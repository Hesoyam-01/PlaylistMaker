<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/make_playlist_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    android:orientation="vertical"
    tools:context=".ui.library.MakePlaylistFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/new_playlist_toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:contentInsetStartWithNavigation="64dp"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/new_playlist"
        app:titleTextAppearance="@style/ToolbarStyle" />

    <ImageView
        android:id="@+id/set_playlist_cover"
        android:layout_width="312dp"
        android:layout_height="312dp"
        android:layout_gravity="center"
        android:layout_marginTop="26dp"
        android:background="@drawable/add_photo_background"
        android:scaleType="center"
        android:src="@drawable/ic_add_photo_100" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/default_padding">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/name_background"
            style="@style/MyTextInputLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:hint="@string/title"
            android:textColorHint="?attr/colorOnPrimary"
            app:hintTextColor="@color/blue"
            app:cursorColor="@color/blue"
            app:boxStrokeColor="@color/text_input_colors">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/playlist_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/ys_display_regular"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/default_padding"
                android:singleLine="true"
                android:textColor="?attr/colorOnPrimary"
                android:textFontWeight="400"
                android:textSize="@dimen/small_textSize" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/description_background"
            style="@style/MyTextInputLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="105dp"
            android:hint="@string/description"
            android:textColorHint="?attr/colorOnPrimary"
            app:hintTextColor="@color/blue"
            app:cursorColor="@color/blue"
            app:boxStrokeColor="@color/text_input_colors">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/playlist_description"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/ys_display_regular"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/default_padding"
                android:singleLine="true"
                android:textColor="?attr/colorOnPrimary"
                android:textFontWeight="400"
                android:textSize="@dimen/small_textSize" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="35dp"
            android:paddingHorizontal="17dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">


            <Button
                android:id="@+id/make_playlist_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/make_button_colors"
                android:elevation="0dp"
                android:enabled="false"
                android:fontFamily="@font/ys_display_medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:text="@string/make"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textFontWeight="500"
                android:textSize="@dimen/small_textSize" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>