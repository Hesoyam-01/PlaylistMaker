<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.PlaylistScreenFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/playlist_toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:contentInsetStartWithNavigation="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/playlist_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="center"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_cover_placeholder_312" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/playlist_name"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:fontFamily="@font/ys_display_bold"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/default_padding"
        android:textColor="@color/dark_gray"
        android:textFontWeight="700"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@+id/playlist_cover"
        tools:text="Best songs 2021" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="21dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/ys_display_regular"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/default_padding"
        android:textColor="@color/dark_gray"
        android:textFontWeight="400"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_name"
        tools:text="2022" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/artist_name"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginTop="8dp"
        android:layout_gravity="center_vertical"
        android:ellipsize="end"
        android:foreground="@android:color/transparent"
        android:maxWidth="173dp"
        android:maxLines="1"
        android:padding="0dp"
        android:textColor="?attr/colorOnPrimaryFixedVariant"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf=""
        tools:text="Metallica">

    </com.google.android.material.textview.MaterialTextView>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginHorizontal="5dp"
        android:layout_marginVertical="5dp"
        android:src="@drawable/ic_ellipse_3"
        app:tint="?attr/colorOnPrimaryFixedVariant">

    </androidx.appcompat.widget.AppCompatImageView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_time"
        style="@style/TrackTextViewStyle"
        android:layout_width="64dp"
        android:layout_height="13dp"
        android:layout_gravity="center_vertical"
        android:foreground="@android:color/transparent"
        android:maxLines="1"
        android:padding="0dp"
        android:textColor="?attr/colorOnPrimaryFixedVariant"
        android:textSize="11sp"
        tools:text="5:32">

    </com.google.android.material.textview.MaterialTextView>

</androidx.constraintlayout.widget.ConstraintLayout>