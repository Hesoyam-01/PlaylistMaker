<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/libraryFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.playlistmaker.ui.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_playerFragment"
            app:destination="@id/playerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left_30"
            app:popEnterAnim="@anim/slide_in_left_30"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.example.playlistmaker.ui.library.LibraryFragment"
        android:label="fragment_library"
        tools:layout="@layout/fragment_library" >
        <action
            android:id="@+id/action_libraryFragment_to_playerFragment"
            app:destination="@id/playerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left_30"
            app:popEnterAnim="@anim/slide_in_left_30"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_libraryFragment_to_makePlaylistFragment"
            app:destination="@id/makePlaylistFragment"
            app:enterAnim="@anim/slide_in_bottom"
            app:exitAnim="@anim/hold"
            app:popExitAnim="@anim/slide_in_up"
            app:popEnterAnim="@anim/hold"/>
        <action
            android:id="@+id/action_libraryFragment_to_playlistScreenFragment"
            app:destination="@id/playlistScreenFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left_30"
            app:popEnterAnim="@anim/slide_in_left_30"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.playlistmaker.ui.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.playlistmaker.ui.player.PlayerFragment"
        android:label="fragment_player"
        tools:layout="@layout/fragment_player" >
        <action
            android:id="@+id/action_playerFragment_to_makePlaylistFragment"
            app:destination="@id/makePlaylistFragment"
            app:enterAnim="@anim/slide_in_bottom"
            app:exitAnim="@anim/hold"
            app:popExitAnim="@anim/slide_in_up"
            app:popEnterAnim="@anim/hold"/>
    </fragment>

    <fragment
        android:id="@+id/makePlaylistFragment"
        android:name="com.example.playlistmaker.ui.makeplaylist.MakePlaylistFragment"
        android:label="MakePlaylistFragment"
        tools:layout="@layout/fragment_make_playlist"/>
    <fragment
        android:id="@+id/playlistScreenFragment"
        android:name="com.example.playlistmaker.ui.playlistscreen.PlaylistScreenFragment"
        android:label="fragment_playlist_screen"
        tools:layout="@layout/fragment_playlist_screen" />
</navigation>